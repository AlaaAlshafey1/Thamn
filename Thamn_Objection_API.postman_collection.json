{
	"info": {
		"_postman_id": "4f726cc3-thamn-objection-api",
		"name": "Thamn - Objection & Re-evaluation API (منظومة الاحتجاج)",
		"description": "مجموعة طلبات Postman الخاصة بـ API الاحتجاج وتعديل المدخلات وإعادة التثمين وأسباب الاحتجاج الجاهزة في تطبيق ثمن.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_SANCTUM_TOKEN_HERE",
			"type": "string"
		},
		{
			"key": "orderId",
			"value": "93",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Settings API (أسباب الاحتجاج الجاهزة)",
			"item": [
				{
					"name": "جلب أسباب الاحتجاج (عربي)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/settings/objection-reasons",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"settings",
								"objection-reasons"
							]
						},
						"description": "ترجع هيكل أسباب الاحتجاج الجديد (formTitle + types + options) باللغة العربية."
					},
					"response": []
				},
				{
					"name": "جلب أسباب الاحتجاج (English)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "en"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/settings/objection-reasons",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"settings",
								"objection-reasons"
							]
						},
						"description": "ترجع هيكل أسباب الاحتجاج الجديد (formTitle + types + options) باللغة الإنجليزية."
					},
					"response": []
				},
				{
					"name": "إعدادات النظام العامة (تشمل أسباب الاحتجاج)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"settings"
							]
						},
						"description": "مسار عام لجلب الإعدادات العامة ومن ضمنها objection_reasons."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Submit Objection (تقديم الاحتجاج)",
			"item": [
				{
					"name": "تقديم احتجاج - باختيار خيار فرعي (مثل 1001 أو 1002)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"order_id\": {{orderId}},\n  \"reason_id\": 1,\n  \"option_id\": 1002,\n  \"notes\": \"السلعة تم شراؤها حديثاً بفاتورة أصلية ولم تُستخدم نهائياً\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/objection",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders",
								"objection"
							]
						},
						"description": "يدعم إرسال reason_id مع option_id (1001 أو 1002)، أو إرسال 1001/1002 مباشرة داخل reason_id."
					},
					"response": []
				},
				{
					"name": "تقديم احتجاج - سبب آخر (other_reason = 3)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"order_id\": {{orderId}},\n  \"reason_id\": 3,\n  \"reason\": \"السعر المقدر أقل بكثير من القيمة الحقيقية للسلعة في السوق حالياً\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/objection",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders",
								"objection"
							]
						},
						"description": "تقديم احتجاج عند اختيار سبب آخر (id: 3) مع كتابة نص السبب."
					},
					"response": []
				},
				{
					"name": "تعديل المدخلات وإعادة التقييم بدون دفع (input_modification)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"answers\": [\n    {\n      \"question_id\": 1,\n      \"option_id\": 5,\n      \"sub_option_id\": null,\n      \"value\": null,\n      \"stageing\": 1\n    },\n    {\n      \"question_id\": 2,\n      \"option_id\": null,\n      \"sub_option_id\": null,\n      \"value\": \"2024\",\n      \"stageing\": 1\n    }\n  ],\n  \"notes\": \"قمت بتصحيح سنة الصنع وحالة السلعة\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/valuation-orders/{{orderId}}/modify-inputs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"valuation-orders",
								"{{orderId}}",
								"modify-inputs"
							]
						},
						"description": "عند اختيار (تعديل المدخلات - input_modification)، يتم إرسال الإجابات المعدلة (answers) والصور المحدثة (images / oldImages) لهذا الـ Endpoint ليتم تحديث الطلب وإعادة تقييمه فوراً بدون دفع."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Order Result (نتيجة التقييم)",
			"item": [
				{
					"name": "عرض نتيجة التقييم وأسباب الاحتجاج المتاحة",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "ar"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/valuation-orders/{{orderId}}/result",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"valuation-orders",
								"{{orderId}}",
								"result"
							]
						},
						"description": "تعرض تفاصيل ونتيجة التقييم، وتتضمن: objection_reasons بالهيكل الجديد، وحقل answers للإجابات الحالية، وحقول التحكم بظهور زر الاحتجاج: is_re_evaluating (هل الطلب قيد إعادة التثمين حالياً)، can_re_evaluate (هل يتاح تقديم اعتراض الآن)، re_evaluation_status (حالة إعادة التثمين: in_progress | completed | available | expired)."
					},
					"response": []
				}
			]
		}
	]
}
